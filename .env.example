# AI Career Radar - gizli bilgiler
# Bu dosyayı ".env" adıyla kopyala ve değerleri doldur. .env ASLA kimseyle paylaşılmaz, Git'e yüklenmez.

# 1) Telegram: @BotFather -> /newbot ile alınan token
TELEGRAM_BOT_TOKEN=
# 2) Botun yalnızca sana cevap vermesi için kendi kullanıcı ID'n (python -m radar whoami ile öğrenilir)
TELEGRAM_ALLOWED_USER_IDS=

# 3) Jooble ücretsiz API anahtarı: https://jooble.org/api/about
JOOBLE_API_KEY=

# 4) Gmail iş alarmları: adresin + 16 haneli "Uygulama şifresi" (normal Gmail şifren DEĞİL)
#    Google Hesabı -> Güvenlik -> 2 Adımlı Doğrulama açık olmalı -> Uygulama şifreleri
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# 5) İsteğe bağlı: Claude API (Claude Pro aboneliğinden AYRIDIR, console.anthropic.com)
#    Boş bırakılırsa sistem ücretsiz, kural tabanlı modda çalışır.
ANTHROPIC_API_KEY=

# VPS/PostgreSQL için (boşsa data/radar.db SQLite kullanılır)
# DATABASE_URL=postgresql+psycopg://kullanici:sifre@localhost/radar
